{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrossfireDebateRoundOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fullResponse",
    "summary",
    "judgements"
  ],
  "properties": {
    "fullResponse": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "extractedClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "statement"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "pro",
              "con",
              "risk",
              "tradeoff",
              "todo"
            ]
          }
        }
      }
    },
    "judgements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "stance",
          "confidence",
          "rationale"
        ],
        "properties": {
          "claimId": {
            "type": "string"
          },
          "stance": {
            "type": "string",
            "enum": [
              "agree",
              "disagree",
              "revise"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rationale": {
            "type": "string"
          },
          "revisedStatement": {
            "type": "string"
          },
          "mergesWith": {
            "type": "string"
          }
        }
      }
    }
  }
}
